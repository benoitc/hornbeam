{erl_opts, [debug_info]}.

%% Xref configuration - ignore unused exports (these are public API)
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

%% Dialyzer configuration
{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling
    ]},
    {plt_extra_apps, [livery, ws]}
]}.

{deps, [
    {livery, "~> 0.8.0"},
    {erlang_python, "3.1.1"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [hornbeam]}
]}.

{relx, [{release, {hornbeam, "1.4.1"},
         [hornbeam,
          sasl]},

        {mode, dev},

        {extended_start_script, true}]}.

{profiles, [
    {test, [
        {deps, [
            {jsx, "3.1.0"}
        ]}
    ]}
]}.

{project_plugins, [rebar3_ex_doc]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {source_url, <<"https://github.com/benoitc/hornbeam">>},
    {homepage_url, <<"https://hornbeam.dev">>},
    {main, <<"readme">>},
    {extras, [
        <<"README.md">>,
        <<"CHANGELOG.md">>
    ]}
]}.
