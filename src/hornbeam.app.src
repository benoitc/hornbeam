{application, hornbeam,
 [{description, "WSGI/ASGI HTTP server powered by the BEAM"},
  {vsn, "1.4.1"},
  {registered, [hornbeam_sup, hornbeam_config]},
  {mod, {hornbeam_app, []}},
  {applications,
   [kernel,
    stdlib,
    livery,
    erlang_python
   ]},
  %% No defaults here on purpose: hornbeam_config:defaults/0 is the one
  %% source, and duplicating values in the env is how they drifted -
  %% `bind' was a string here and a binary there, so a reset produced a
  %% different type from a fresh start. The env is for overrides only.
  {env,[]},
  {modules, []},
  {licenses, ["Apache-2.0"]},
  {links, [
    {"GitHub", "https://github.com/benoitc/hornbeam"},
    {"Website", "https://hornbeam.dev"}
  ]}
 ]}.
