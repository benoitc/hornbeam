%% Every hornbeam option defaults in hornbeam_config:defaults/0. Set a
%% key here only to override one; `hornbeam_config:env_keys/0' lists
%% what is recognised, and an unknown key is ignored rather than
%% refused, which is why this file stays short.
[
    {hornbeam, [
        {bind, <<"127.0.0.1:8642">>},
        {worker_class, wsgi},
        {pythonpath, [<<".">>, <<"examples">>]}
    ]},
    {erlang_python, [
        {num_contexts, 4},
        {max_concurrent, 10000}
    ]}
].
